<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/header_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_menu"
                android:padding="16dp"
                android:src="@drawable/ic_menu"
                android:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Keep readings near the top, and anchor the round power control
             near the bottom where it is easier to reach with one hand. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="78dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:text="↓"
                        android:textColor="@color/download_accent"
                        android:textSize="31sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/download_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/download_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero_speed"
                        android:textColor="@color/text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:gravity="end"
                        android:maxLines="1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="wrap_content"
                        android:text="↑"
                        android:textColor="@color/upload_accent"
                        android:textSize="31sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/upload_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/upload_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zero_speed"
                        android:textColor="@color/text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:fontFamily="sans"
                        android:gravity="end"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- One 100dp circular toggle, with a single centered power icon.
                 Accessibility text is set dynamically in MainActivity. -->
            <FrameLayout
                android:id="@+id/power_button"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="96dp"
                android:background="@drawable/bg_button_inactive"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/start_monitoring">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_power"
                    android:contentDescription="@null"
                    android:tint="@color/text_primary" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Right-side drawer, with About content directly in the panel. -->
    <FrameLayout
        android:id="@+id/drawer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawer_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:contentDescription="@string/close_menu" />

        <ScrollView
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:fillViewport="true"
            android:background="@color/drawer_bg"
            android:elevation="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/ic_launcher"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/drawer_close"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:tint="@color/text_secondary"
                        android:contentDescription="@string/close_menu" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingBottom="8dp"
                    android:text="@string/about_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="16dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/about_body"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <View style="@style/DrawerDivider" />

                <TextView
                    android:id="@+id/nav_repository"
                    style="@style/DrawerItem"
                    android:text="@string/github_repository" />

                <TextView
                    android:id="@+id/nav_report_issue"
                    style="@style/DrawerItem"
                    android:text="@string/report_issue" />

                <View style="@style/DrawerDivider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="5dp"
                    android:text="@string/version_label"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawer_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <View style="@style/DrawerDivider" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="25dp"
                    android:paddingBottom="24dp"
                    android:text="@string/made_in_palestine"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
